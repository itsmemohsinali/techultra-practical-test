<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_message_delete_audit_list" model="ir.ui.view">
        <field name="name">mail.message.delete.audit.list</field>
        <field name="model">mail.message.delete.audit</field>
        <field name="arch" type="xml">
            <list string="Deleted Messages" create="false" edit="false" delete="false">
                <field name="deleted_on"/>
                <field name="deleted_by"/>
                <field name="message_id_char"/>
                <field name="model"/>
                <field name="res_id"/>
                <field name="delete_reason"/>
            </list>
        </field>
    </record>

    <record id="view_mail_message_delete_audit_form" model="ir.ui.view">
        <field name="name">mail.message.delete.audit.form</field>
        <field name="model">mail.message.delete.audit</field>
        <field name="arch" type="xml">
            <form string="Deleted Message" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="message_id_char"/>
                            <field name="model"/>
                            <field name="res_id"/>
                            <field name="deleted_by"/>
                            <field name="deleted_on"/>
                        </group>
                        <group>
                            <field name="delete_reason"/>
                        </group>
                    </group>
                    <group string="Original Content">
                        <field name="message_body" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mail_message_delete_audit" model="ir.actions.act_window">
        <field name="name">Audit Records</field>
        <field name="res_model">mail.message.delete.audit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
