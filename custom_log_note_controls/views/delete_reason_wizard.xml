<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delete_message_reason_wizard_form" model="ir.ui.view">
        <field name="name">delete.message.reason.wizard.form</field>
        <field name="model">delete.message.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Message Deletion">
                <div class="text-muted mb-3">
                    The message will be permanently deleted and recorded in the audit log.
                </div>
                <group>
                    <field name="message_id" invisible="1"/>
                    <field name="reason" placeholder="Describe why this message should be deleted..."/>
                </group>
                <footer>
                    <button name="action_confirm_delete" type="object" string="Confirm Deletion" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
